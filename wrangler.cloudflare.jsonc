{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "value",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wenying-value-radar-private",
      "database_id": "78e7a1f7-0946-4c1e-8e65-83b7a3121220",
      "migrations_dir": "./drizzle"
    }
  ],
  "triggers": {
    "crons": ["15 1 * * *", "30 3 15 1,4,7,10 *", "30 22 * * 1-5"]
  },
  "observability": {
    "enabled": true
  }
}
